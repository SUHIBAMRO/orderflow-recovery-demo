FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PUBLIC_DEMO=1 DATA_DIR=/data
WORKDIR /app
RUN useradd --uid 10001 --create-home orderflow && mkdir /data && chown 10001:10001 /data
COPY --chown=10001:10001 orderflow ./orderflow
COPY --chown=10001:10001 web ./web
USER 10001
EXPOSE 8080
CMD ["python", "-m", "orderflow.hosted"]
